# Supabase (projet en ligne, région Frankfurt)
SUPABASE_URL=
SUPABASE_KEY=                 # anon key (client)
SUPABASE_SERVICE_KEY=         # service role (serveur uniquement, jamais dans le bundle client)
DATABASE_URL=                 # connexion directe 5432 (pg-boss + drizzle), pas le pooler
# Vercel : pooler Supavisor en mode session (port 5432 du pooler). La connexion directe
# est IPv6-only, les fonctions Vercel n'ont pas d'egress IPv6. Jamais le port 6543 (mode
# transaction) : il ne supporte pas les prepared statements.
DATABASE_URL_POOLER=
# Email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Transport : `resend` (défaut) ou `smtp` (pile Docker, Mailpit). Voir docs/DOCKER.md.
MAIL_TRANSPORT=resend
SMTP_URL=
MAIL_FROM=
# Tracking
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
GA4_API_SECRET=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_CAPI_TEST_EVENT_CODE=
TRACKING_ENABLED=false
# Tâches planifiées (vercel.json). Vercel pose ce jeton dans l'en-tête Authorization.
CRON_SECRET=
# App
APP_BASE_URL=http://localhost:3000
RESEND_FROM=Radar by FeexPay <onboarding@resend.dev>
