# Environnement de la pile Docker (docker-compose.yml).
#
#   cp docker/.env.example docker/.env
#   node docker/scripts/generer-secrets.mjs >> docker/.env
#   docker compose --env-file docker/.env up -d --build
#
# Les secrets générés sont ajoutés à la fin du fichier : en cas de doublon, c'est la
# dernière ligne qui compte. `docker/.env` n'est pas versionné.

# --- Secrets (générés, ne rien écrire ici à la main) -------------------------
JWT_SECRET=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
POSTGRES_PASSWORD=
CRON_SECRET=

# --- Base --------------------------------------------------------------------
POSTGRES_DB=radar
# Port publié sur la machine hôte, pour psql ou un client graphique.
POSTGRES_PORT=5432

# --- Adresses ----------------------------------------------------------------
# Ce que voit le navigateur. Sert aux liens des emails, des rapports et des cartes.
APP_BASE_URL=http://localhost:3000
APP_PORT=3000
# Origine de l'authentification et de PostgREST, vue depuis la machine hôte.
GATEWAY_PORT=8000
SUPABASE_URL_PUBLIC=http://localhost:8000
# Boîte de réception Mailpit.
MAILPIT_PORT=8025

# --- Email -------------------------------------------------------------------
# `smtp` envoie tout à Mailpit. `resend` sort vraiment : il faut alors RESEND_API_KEY.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://mail:1025
MAIL_FROM=Radar by FeexPay <radar@radar.local>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Tâches planifiées -------------------------------------------------------
# Mêmes horaires que vercel.json, dans le fuseau ci-dessous (Vercel planifie en UTC).
CRON_ABANDON=0 3 * * *
CRON_RELANCE=0 8 * * *
TZ=UTC

# --- Tracking ----------------------------------------------------------------
TRACKING_ENABLED=false
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
